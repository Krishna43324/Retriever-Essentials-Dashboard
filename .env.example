# Copy this file to .env and change the values. Never commit .env.
#   Docker:        docker compose up --build
#   Without Docker: python backend/flask_start.py (needs your own MySQL 8)

# --- MySQL -----------------------------------------------------------------
# Docker Compose creates this user/database for you and overrides DB_HOST with
# the service name ("db"). For a local, non-Docker MySQL, DB_HOST=127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retriever
DB_PASSWORD=change-me-db-password
DB_NAME=retriever_dashboard
DB_CONNECTION_TIMEOUT=10
DB_STARTUP_ATTEMPTS=20
DB_STARTUP_DELAY=2

# Docker only
DB_ROOT_PASSWORD=change-me-root-password
DB_HOST_PORT=3307
APP_PORT=5000

# --- Flask -----------------------------------------------------------------
FLASK_HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=true
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- First admin login -----------------------------------------------------
# Created automatically on first start if no admin exists. Only the bcrypt hash
# is stored. Change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
