# Copy this file to .env and fill in your local MySQL credentials.
# In Docker Compose, DB_HOST should be the MySQL service name (for example: db).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=retriever_dashboard
DB_CONNECTION_TIMEOUT=10
DB_STARTUP_ATTEMPTS=20
DB_STARTUP_DELAY=2

# Flask settings
FLASK_HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=true

# Temporary demo login only; database-backed authentication is a later step.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD_HASH=
